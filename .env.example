# Copy to .env and fill in. .env is gitignored; never commit it.

# --- Flagsmith Management API (bot only, secret) -------------------------
# Organisation API key: Organisation -> API Access -> Create API Key.
# Used only by autopilot/flagsmith_client.py. Never give it to the demo shop.
# Fallback if Api-Key is rejected: FS_AUTH_SCHEME=Token with your personal token.
FS_TOKEN=
FS_AUTH_SCHEME=Api-Key

FS_PROJECT_ID=56321

# Client-side environment key (not secret). Production.
# Development is JM8wUtydhVkCAb9SNF2zE9.
FS_ENV_KEY=YVBbF2u3wfxhGLS8StCbhU

# Flag used only by scripts/smoke_flagsmith.py
FS_TEST_FEATURE_NAME=show_demo_button

# --- GitHub (the bot reads PRs, comments, commits the flag wrapper) -------
