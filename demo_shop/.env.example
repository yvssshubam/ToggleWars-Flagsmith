# Copy to demo_shop/.env. The shop reads ONLY this file, never the root .env.
# Never put the Organisation API key here.

# Server-side environment key for Production (secret, starts with "ser.").
# Flagsmith: Production environment -> Settings -> SDK Keys -> create server-side key.
FLAGSMITH_SERVER_KEY=

# Where the bot receives metrics events. Empty until the bot exists (step 5).
AUTOPILOT_METRICS_URL=

# How often the SDK re-downloads the environment document (each download is
# one billable request; 10s = 360/hour while the shop runs).
FLAGSMITH_REFRESH_SECONDS=10
